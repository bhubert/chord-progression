---
/**
 * Gabarit unique. Les polices sont auto-hébergées (`public/polices/`) et les
 * feuilles de style restent en fichiers : la politique de sécurité de
 * `public/_headers` refuse tout style ou script glissé dans le HTML.
 */
import '../styles/polices.css';
import '../styles/global.css';

interface Props {
  titre: string;
  description: string;
}

const { titre, description } = Astro.props;
const canonique = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1b1411" />
    <link rel="canonical" href={canonique} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:locale" content="fr_FR" />
  </head>
  <body>
    <slot />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
